# Gramavance Environment Variables
# Copy this file to .env and configure your keys

# Google Gemini API Key (powers live Generative AI Assistant & Document Analysis)
# Get your free key at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Supabase Backend Configuration (optional, for cloud database & auth)
# Get keys from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

